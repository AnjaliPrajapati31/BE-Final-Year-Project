APP_NAME=AI Agriculture API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://agri_sickle:CHANGE_ME@localhost:5432/agri_sickle
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10

EARTH_ENGINE_ENABLED=true
EARTH_ENGINE_PROJECT_ID=your-google-cloud-project-id
EARTH_ENGINE_AUTH_MODE=adc
EARTH_ENGINE_ENDPOINT=https://earthengine.googleapis.com
# Optional fallback: absolute path outside this repository. Prefer local ADC.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/google/earth-engine-service-account.json
EARTH_ENGINE_REQUEST_TIMEOUT_SECONDS=120
EARTH_ENGINE_MAX_RETRIES=2
EARTH_ENGINE_CACHE_ROOT=cache/earth_engine
EARTH_ENGINE_CACHE_TTL_SECONDS=86400

SICKLE_CHECKPOINT_PATH=ml_models/sickle/checkpoint_best.pt
SICKLE_DEVICE=auto
SICKLE_MAX_CONCURRENT_INFERENCES=1

CAUVERY_ROI_CODE=cauvery_delta_pilot
CAUVERY_ROI_VERSION=2
CAUVERY_ROI_PATH=resources/cauvery/v2/cauvery_delta_pilot_v2.geojson
FIELD_MIN_AREA_M2=100
FIELD_MAX_AREA_M2=78400
FIELD_MAX_WIDTH_M=280
FIELD_MAX_HEIGHT_M=280
FIELD_MAX_VERTICES=10000
CROP_ZERO_FRACTION_LIMIT=0.25
CROP_MIN_S1_OBSERVATIONS=1
CROP_MIN_S2_OBSERVATIONS=1

SICKLE_ARTIFACTS_ENABLED=false
SICKLE_ARTIFACT_ROOT=artifacts/sickle

# Optional, non-authoritative explanation layer. Scientific outputs do not depend on it.
AI_EXPLANATION_ENABLED=false
AI_EXPLANATION_API_KEY=
AI_EXPLANATION_MODEL=
AI_EXPLANATION_ENDPOINT=https://api.openai.com/v1/responses
AI_EXPLANATION_TIMEOUT_SECONDS=30
